# Lab-report scanning. Prefer Zion action-flow or direct vision — otherwise the app
# falls back to on-device PP-OCR (heavy on mobile) then manual entry.
# Put real keys and flow ids in .env.local. That file is gitignored.
# Production/cave builds bake VITE_* at build time; empty means no AI on that deploy.

# Preferred: a Zion action flow reads the project secret zhipu_api_key and calls
# a vision model. Input is { image: dataUrl, prompt }. The flow returns a JSON
# string; see PARSE_PROMPT in scanEngines.ts. VITE_ZION_API is optional.
VITE_ZION_SCAN_FLOW_ID=
VITE_ZION_API=

# Scan photo + scan_record upload. Defaults to operating backend PO76RBe9QQV.
# Set VITE_ZION_UPLOAD=0 to keep photos local-only (IndexedDB).
# VITE_ZION_DATA_API=
# VITE_ZION_UPLOAD=

# Local demo only. This key is bundled into the frontend.
# Zhipu example: VITE_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VITE_VISION_BASE_URL=
VITE_VISION_API_KEY=
VITE_VISION_MODEL=
